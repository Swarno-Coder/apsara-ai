# Environment configuration for AI Companion Backend

# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Database Configuration
DATABASE_URL=sqlite:///companion.db

# Whisper STT Configuration
WHISPER_MODEL_PATH=./models/whisper/ggml-base.bin
WHISPER_EXECUTABLE=whisper
WHISPER_MODEL_SIZE=base

# Piper TTS Configuration  
PIPER_EXECUTABLE=piper
PIPER_MODELS_DIR=./models/piper
TTS_OUTPUT_DIR=./audio_cache

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Security
SECRET_KEY=your-secret-key-change-this-in-production

# Logging
LOG_LEVEL=INFO
